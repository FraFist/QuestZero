{
  "name": "questzero-backend",
  "version": "1.0.0",
  "description": "Backend QuestZero (Supabase)",
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "status": "supabase status",
    "test": "supabase test db",
    "test:unit": "deno test supabase/tests/functions/unit",
    "test:functions": "deno test --allow-net --allow-env --allow-run --allow-read supabase/tests/functions/integration",
    "check": "deno check supabase/functions/pair/index.ts supabase/functions/events/index.ts supabase/functions/invite-participant/index.ts supabase/functions/xapi-sender/index.ts",
    "lrs:start": "docker run -d --rm --name questzero-lrs --network supabase_network_questzero -p 44380:8080 -e LRSQL_API_KEY_DEFAULT=questzero-locale -e LRSQL_API_SECRET_DEFAULT=solo-per-test-locali -e LRSQL_ADMIN_USER_DEFAULT=admin -e LRSQL_ADMIN_PASS_DEFAULT=solo-per-test-locali yetanalytics/lrsql:latest",
    "lrs:stop": "docker stop questzero-lrs"
  },
  "type": "commonjs",
  "private": true,
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^3.3.0"
  }
}
