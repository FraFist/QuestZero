# Copia questo file in .env.local (mai committato) e riempi i valori.
# In locale: dalla cartella backend/ lancia `npm run status` e copia "API URL" e "Publishable key".
# Online: sito Supabase → Project Settings → API (URL del progetto e chiave publishable/anon).
# La chiave publishable è fatta per stare nel browser: la sicurezza la fanno le regole RLS del database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
